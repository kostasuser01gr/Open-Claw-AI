{
  "name": "open-claw-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist coverage functions/lib",
    "lint": "tsc --noEmit",
    "typecheck": "npm run lint",
    "lint:sast": "eslint . --max-warnings=0",
    "functions:lint": "npm run lint --prefix functions",
    "functions:build": "npm run build --prefix functions",
    "functions:test": "npm test --prefix functions",
    "audit:prod": "npm audit --omit=dev",
    "audit:prod:functions": "npm audit --omit=dev --prefix functions",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "node ./scripts/run-firestore-rules-tests.mjs",
    "ci:validate": "npm run lint && npm run lint:sast && npm test && npm run test:coverage && npm run build && npm run functions:lint && npm run functions:build && npm run functions:test",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:all": "npm run build && npm run functions:build && firebase deploy",
    "deploy": "npm run deploy:all"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.4.1",
    "vitest": "^4.1.2"
  }
}
