# Client runtime configuration
# Gemini credentials are no longer injected into the browser bundle.
# Configure the server-side key with Firebase Secrets or functions/.secret.local for emulator use.

# Firebase config — get these from Firebase Console → Project Settings → Web app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DB_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_FIREBASE_FUNCTIONS_REGION="us-central1"
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_FUNCTIONS_HOST="127.0.0.1"
VITE_FIREBASE_FUNCTIONS_PORT="5001"

# Set this to your deployed Cloudflare Worker URL to bypass Firebase Functions
# for chat + streaming. Leave empty to keep the legacy Firebase path.
# Example: https://openclaw-api.<your-subdomain>.workers.dev
VITE_WORKER_URL=""
