# Client runtime configuration
# Gemini credentials are no longer injected into the browser bundle.
# Configure the server-side key with Firebase Secrets or functions/.secret.local for emulator use.

VITE_FIREBASE_FUNCTIONS_REGION="us-central1"
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_FUNCTIONS_HOST="127.0.0.1"
VITE_FIREBASE_FUNCTIONS_PORT="5001"
